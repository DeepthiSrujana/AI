import random

# Define the environment class
class Environment:
    def __init__(self):
        # Initialize the condition of locations A and B (0 = Clean, 1 = Dirty)
        self.locationCondition = {'A': random.randint(0, 1), 'B': random.randint(0, 1)}

# Define the vacuum agent class
class SimpleReflexVacuumAgent:
    def __init__(self, environment):
        # Store the environment reference and initialize performance score
        self.environment = environment
        self.score = 0
        
        print("Initial Environment State:", self.environment.locationCondition)

        # Randomly place the vacuum at location A (0) or B (1)
        vacuum_location_idx = random.randint(0, 1)
        
        # Determine the sequence of locations to visit based on the starting point
        if vacuum_location_idx == 0:
            location_sequence = ['A', 'B']
        else:
            location_sequence = ['B', 'A']
            
        # Execute the agent cycle for both locations sequentially
        for current_location in location_sequence:
            print(f"\nVacuum is now at Location {current_location}.")
            
            # Perceive environment state at the current location
            if self.environment.locationCondition[current_location] == 1:
                print(f"Status: Location {current_location} is Dirty.")
                # Action: Clean the room
                self.environment.locationCondition[current_location] = 0
                self.score += 1
                print(f"Action: Location {current_location} has been Cleaned.")
            else:
                print(f"Status: Location {current_location} is Clean. No action needed.")

        # Print final summary metrics
        print("\n" + "=" * 40)
        print("Final Environment State:", self.environment.locationCondition)
        print("Performance Measurement Score: " + str(self.score))
        print("=" * 40)

# Main Execution Flow
if __name__ == "__main__":
    # Create an instance of the Environment class
    theEnvironment = Environment()
    # Create an instance of the SimpleReflexVacuumAgent class with the environment instance
    theVacuum = SimpleReflexVacuumAgent(theEnvironment)




